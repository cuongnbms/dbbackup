# PostgreSQL connection (all required)
PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_SSLMODE=disable

# Optional: symmetric GPG passphrase. Leave empty to skip encryption.
ENCRYPT_KEY=

# Azure Blob Storage (required only when remote_backup.azure_blob_storage.enable is true)
ABS_ACCOUNT_NAME=
ABS_ACCESS_KEY=
ABS_CONTAINER=
